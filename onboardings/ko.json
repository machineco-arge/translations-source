  },
  "onboardingNegativesStepMessage": {
    "translation": "필름을 현상하기 전에 해당 필름 롤의 디지털 네거티브를 확인할 수 있습니다.",
    "sourceHash": "cc46586a29e4552c7d52bc081df57727"
